# =========================================
# IntelliJ IDEA + Java + macOS .gitignore
# =========================================

# OS-specific files
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
ehthumbs.db
Icon?
._*

# IntelliJ IDEA specific
.idea/
*.iml
*.iws
*.ipr
out/
# IntelliJ logs, caches, indexes
.idea/**/workspace.xml
.idea/**/tasks.xml
.idea/**/usage.statistics.xml
.idea/**/dictionaries
.idea/**/shelf/
.idea/**/httpRequests/
.idea/**/dataSources/
.idea/**/dataSources.local.xml
.idea/**/gradle.xml
.idea/**/libraries
.idea/**/modules.xml
.idea/**/sqlDataSources.xml
.idea/**/dynamic.xml

# Gradle
.gradle/
build/

# Github
.github/

# Maven
target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
release.properties

# Logs and temp files
*.log
*.tmp
*.swp
*.swo
*.bak
*.old

# Java compiled files
*.class
*.jar
*.war
*.ear

# Package distribution files
*.zip
*.tar.gz
*.rar

# Generated files
bin/
gen/
dist/

# Environment files
.env
.env.*

# IntelliJ plugin settings (optional)
# Remove comment if using these
# .idea/runConfigurations/
# .idea/inspectionProfiles/

# =========================================
# End of file
# =========================================

